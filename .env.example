# Canonical, absolute site URL. Used for metadataBase, sitemap, robots and
# Open Graph / JSON-LD absolute URLs. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://what-episode.com

# TMDB credential for `bun run fetch:catalogue` (episode data). Use either the
# v4 read access token (preferred) or the v3 api key. Local-only / build-time —
# NOT required at runtime because the catalogue is committed to the repo.
TMDB_ACCESS_TOKEN=
# TMDB_API_KEY=

# Refresh cron (Vercel). Only needed in the Vercel project, not locally.
# CRON_SECRET: shared secret Vercel Cron sends as `Authorization: Bearer <secret>`.
# DEPLOY_HOOK_URL: Vercel Deploy Hook the cron pings to trigger a rebuild.
CRON_SECRET=
DEPLOY_HOOK_URL=
