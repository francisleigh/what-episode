# dependencies
/node_modules
/.pnp
.pnp.*

# Lockfile is intentionally untracked: local installs run through a private
# registry proxy and bake non-public tarball URLs into it, which break CI/Vercel
# builds. Vercel resolves from public npm instead. Regenerate + force-add a clean
# lockfile only from a machine with direct public-npm access.
bun.lockb
bun.lock

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env
.env*.local

# typescript
*.tsbuildinfo

# editor
/.idea
/.vscode
